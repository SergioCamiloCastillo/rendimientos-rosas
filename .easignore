# EAS usa este archivo en lugar de .gitignore al subir el proyecto para compilar.
# Es igual a .gitignore, pero SÍ incluye assets/fonts/*.ttf, que la app necesita
# y que no están en git por su licencia.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
